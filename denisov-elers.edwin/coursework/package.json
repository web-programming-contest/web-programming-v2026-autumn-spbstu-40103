{
  "name": "gadget-hub",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "node --import tsx --test backend/src/*.test.ts",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=./.playwright playwright test",
    "format:check": "prettier --check frontend/src backend/src shared README.md"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0"
  }
}
